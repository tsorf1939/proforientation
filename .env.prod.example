POSTGRES_DB=proforientation
POSTGRES_USER=prof_user
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgres://prof_user:change-me-to-a-strong-password@db:5432/proforientation

# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=False
# Домен(ы) сервера, через запятую, без схемы
ALLOWED_HOSTS=yourdomain.com

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Если фронтенд и API на одном домене через Caddy — CORS не нужен (запросы relative /api).
# Если фронтенд обращается на другой origin — укажи его явно.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Обязательно: без этого Django отклоняет POST-формы (вход в /admin/ и т.п.)
# с ошибкой CSRF, т.к. не знает, что https://yourdomain.com — доверенный origin.
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Адрес сайта для Caddy: домен -> автоматический HTTPS (Let's Encrypt);
# IP без домена -> http://IP_АДРЕС (без сертификата)
SITE_ADDRESS=https://yourdomain.com
